{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "worktreeSetupCache": {
    "inputs": [
      "**/package.json",
      "**/pnpm-lock.yaml",
      "**/pnpm-workspace.yaml",
      "**/.npmrc",
      "**/.pnpmfile.*",
      "**/.node-version",
      "**/.nvmrc",
      "**/.tool-versions",
      "**/vite.config.*",
      "**/*.tgz",
      "patches/**",
      "scripts/setup-worktree.ts"
    ]
  },
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "node scripts/setup-worktree.ts",
      "icon": "configure",
      "runOnWorktreeCreate": true
    }
  ]
}
