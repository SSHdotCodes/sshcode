@@ -89,6 +89,29 @@ internal final class NotificationDelegateRegistry {
   func removeAllPendingResponses() {
     state.withLock { $0.pendingResponses.removeAll() }
   }
+
+  /**
+   Removes only the given responses, keeping responses that arrived while delegate callbacks
+   were running and still have to be offered to other delegates.
+   */
+  func removePendingResponses(_ responses: [UNNotificationResponse]) {
+    let identifiers = Set(responses.map(ObjectIdentifier.init))
+    state.withLock { state in
+      state.pendingResponses.removeAll { identifiers.contains(ObjectIdentifier($0)) }
+    }
+  }
+
+  /**
+   Registers the response and snapshots the delegates in one lock pass, so a delegate that
+   registers during delivery is offered the response by its own replay and never receives
+   the in-flight delivery as well. The lock is released before any delegate callback runs.
+   */
+  func appendPendingResponseAndSnapshotDelegates(_ response: UNNotificationResponse) -> [NotificationDelegate] {
+    state.withLock { state in
+      state.pendingResponses.append(response)
+      return state.delegates
+    }
+  }
 }
 
