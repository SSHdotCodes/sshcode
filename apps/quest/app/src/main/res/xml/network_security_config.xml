<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- A paired server may be any LAN hostname. WebView navigation and resource requests
         are restricted to that configured origin in PanelWebView. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
