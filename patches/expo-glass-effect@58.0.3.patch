+// Only chat surfaces with a fallback and their glass container register here.
+// UIKit can leave their view hierarchy attached while the scene is inactive.
+@MainActor
+final class GlassRenderingRecovery: NSObject {
+  static let shared = GlassRenderingRecovery()
+  private let attached = NSHashTable<UIView>.weakObjects()
+  private let logger = os.Logger(subsystem: "com.t3tools.t3code", category: "glass")
+  private var appearanceLogPending = false
+
+  private override init() {
+    super.init()
+    for name in [UIApplication.didBecomeActiveNotification,
+                 UIApplication.willResignActiveNotification,
+                 UIApplication.didEnterBackgroundNotification,
+                 UIApplication.didReceiveMemoryWarningNotification] {
+      NotificationCenter.default.addObserver(self, selector: #selector(handleLifecycle(_:)), name: name, object: nil)
+    }
+  }
+
+  func track(_ view: UIView, attached isAttached: Bool) {
+    if isAttached {
+      attached.add(view)
+    } else {
+      attached.remove(view)
+    }
+  }
+
+  @objc private func handleLifecycle(_ notification: Notification) {
+    if notification.name == UIApplication.willResignActiveNotification {
+      record("inactive")
+      return
+    }
+    if notification.name == UIApplication.didEnterBackgroundNotification {
+      record("background")
+      return
+    }
+    let active = notification.name == UIApplication.didBecomeActiveNotification
+    record(active ? "active" : "memory-warning")
+    if UIApplication.shared.applicationState != .background {
+      for view in attached.allObjects {
+        (view as? GlassContainer)?.requestEffectRefresh()
+        (view as? GlassView)?.requestEffectRefresh()
+      }
+    }
+  }
+
+  func recordAppearanceChange() {
+    guard !appearanceLogPending else { return }
+    appearanceLogPending = true
+    DispatchQueue.main.async {
+      self.appearanceLogPending = false
+      self.record("appearance")
+    }
+  }
+
+  private func record(_ reason: String) {
+    let views = attached.allObjects.compactMap { $0 as? GlassView }
+    let installed = views.filter(\.hasInstalledGlass).count
+    let sceneStyle = views.first?.window?.traitCollection.userInterfaceStyle.rawValue ?? 0
+    let appState = UIApplication.shared.applicationState.rawValue
+    let glassAPI = (NSClassFromString("UIGlassEffect") as? NSObject.Type)?.responds(to: Selector(("effectWithStyle:"))) ?? false
+    let reduceTransparency = UIAccessibility.isReduceTransparencyEnabled
+    let lowPower = ProcessInfo.processInfo.isLowPowerModeEnabled
+    logger.notice("glass \(reason, privacy: .public) app=\(appState) style=\(sceneStyle) available=\(glassAPI) installed=\(installed)/\(views.count) reduceTransparency=\(reduceTransparency) lowPower=\(lowPower)")
+  }
+}
